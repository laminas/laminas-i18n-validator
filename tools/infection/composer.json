{
    "config": {
        "platform": {
            "php": "8.2.99"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "laminas/laminas-i18n": "^3.0.x-dev",
        "laminas/laminas-servicemanager": "^4.5.0",
        "laminas/laminas-translator": "^2.0.x-dev",
        "laminas/laminas-validator": "dev-translator-v2",
        "psr/container": "^1.0 || ^2.0"
    },
    "require-dev": {
        "psalm/plugin-phpunit": "^0.19.7",
        "roave/infection-static-analysis-plugin": "^1.40",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\I18n\\Filter\\": "../../src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\I18n\\Filter\\": "../../test/"
        }
    },
    "repositories": [
        {
            "type": "github",
            "url": "https://github.com/gsteel/laminas-validator"
        }
    ]
}
