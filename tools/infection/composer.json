{
    "config": {
        "platform": {
            "php": "8.2.99"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "require": {
        "php": "~8.2 || ~8.3 || ~8.4 || ~8.5",
        "ext-intl": "*",
        "laminas/laminas-filter": "^3.4.0",
        "laminas/laminas-servicemanager": "^4.5.0",
        "psr/container": "^1.0 || ^2.0"
    },
    "require-dev": {
        "psalm/plugin-phpunit": "^0.19.5",
        "roave/infection-static-analysis-plugin": "^1.40",
        "vimeo/psalm": "^6.14.2"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\I18n\\Filter\\": "../../src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\I18n\\Filter\\": "../../test/"
        }
    }
}
